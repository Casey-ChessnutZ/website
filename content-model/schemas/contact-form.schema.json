{
  "sys": { "id": "contactForm", "displayField": "title" },
  "name": "Contact Form",
  "description": "Editor-managed public contact form definition",
  "displayField": "title",
  "fields": [
    { "id": "title", "name": "Title", "type": "Symbol", "required": true, "localized": false },
    { "id": "intro", "name": "Introduction", "type": "Text", "required": true, "localized": false },
    { "id": "successMessage", "name": "Success message", "type": "Text", "required": true, "localized": false },
    { "id": "recipientEmail", "name": "Recipient email", "type": "Symbol", "required": false, "localized": false, "validations": [{ "regexp": { "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" } }] },
    { "id": "fields", "name": "Legacy fields", "type": "Array", "required": false, "omitted": true, "localized": false, "items": { "type": "Object" } },
    { "id": "fieldDefinitions", "name": "Fields", "type": "Object", "required": true, "localized": false }
  ]
}
