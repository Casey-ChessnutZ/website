{
    "name": "casey-chessnutz-website",
    "private": true,
    "version": "0.0.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:isolated": "NEXT_DIST_DIR=.next-isolated CONTENTFUL_OFFLINE=true next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "node --experimental-strip-types --test tests/**/*.test.ts",
        "verify:isolated": "CONTENTFUL_OFFLINE=true npm run test && CONTENTFUL_OFFLINE=true npm run lint && npm run build:isolated",
        "mcp:start": "npx -y @contentful/mcp-server",
        "migrations:run": "node scripts/run-migrations.js",
        "contentful:sync": "node scripts/contentful-zero-touch.js"
    },
    "dependencies": {
        "@contentful/rich-text-react-renderer": "^16.2.2",
        "@contentful/rich-text-types": "^17.2.7",
        "contentful-management": "^12.0.0",
        "next": "^15.4.5",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.18.0",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "eslint": "^9.34.0",
        "eslint-config-next": "^15.4.5",
        "postcss": "^8.5.26",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.2"
    }
}
